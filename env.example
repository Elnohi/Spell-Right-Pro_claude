# ─── SpellRightPro API — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub. Add it to .gitignore.

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
# The Gmail address that sends welcome and confirmation emails.
EMAIL_USER=spellrightpro@gmail.com

# A Gmail App Password (NOT your main Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Required: server will refuse to start without this.
EMAIL_PASSWORD=your_gmail_app_password_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3801
NODE_ENV=production

# ── Stripe (for future webhook handling) ─────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Firebase Admin (for updating Firestore after payment) ─────────────────────
# FIREBASE_PROJECT_ID=spellrightpro-firebase
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Google Places (for real testimonials on /premium — netlify/functions/google-reviews.js) ──
# Places API key, restricted to the Places API and (ideally) your Netlify function's outbound IPs.
# Create at: https://console.cloud.google.com/apis/credentials
# GOOGLE_PLACES_API_KEY=your_places_api_key_here
#
# SpellRightPro's Google Business Profile Place ID (starts with "ChIJ").
# Look it up at: https://developers.google.com/maps/documentation/places/web-service/place-id
# (search "SpellRightPro" or your business address in the Place ID Finder)
# GOOGLE_PLACE_ID=ChIJ...
#
# Until both are set, the testimonials section on /premium stays hidden — it never
# shows fabricated reviews as a fallback.
