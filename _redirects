# ─── Never serve backend / internal files ───────────────────────────
# publish = "." means every file in the repo is public unless blocked here.
# server.js etc. are needed in the repo for the Cloud Run build, so we block
# them at the edge instead of moving them. "404!" forces the rule even though
# the file exists. These MUST stay above every other rule.
/server.js                         /404.html  404!
/package.json                      /404.html  404!
/package-lock.json                 /404.html  404!
/dockerfile                        /404.html  404!
/Dockerfile                        /404.html  404!
/env.example                       /404.html  404!
/.env                              /404.html  404!
/DEPLOY_NOTES.md                   /404.html  404!
/.netlifyignore                    /404.html  404!
/netlify/*                         /404.html  404!
/diag.html                         /404.html  404!
/diag                              /404.html  404!
/spellrightpro_file_structure.html /404.html  404!
/footer.html                       /404.html  404!
/social-posts.html                 /404.html  404!
/social-posts                      /404.html  404!

